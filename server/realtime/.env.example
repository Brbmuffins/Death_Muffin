# Local dev: trust tokens without signature verification (NEVER in production)
DEV_TRUST_TOKENS=1
CORS_ORIGIN=http://localhost:5188
REALTIME_PORT=5000

# Production (VPS): do not create a .env there — the systemd unit runs with
#   Environment=ENV_FILE=/opt/rod-auth/.env
#   Environment=CORS_ORIGIN=https://playcrossworlds.com
# so JWT_SECRET is read in place from the auth server's env, never duplicated.
