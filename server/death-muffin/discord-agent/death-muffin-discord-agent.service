# Death Muffin Discord dev-agent runner (loopback HTTP, talks to the muffin-discord bot adapter). Installed by install-runner.sh.
# Runs as ubuntu WITHOUT NoNewPrivileges/ProtectHome: the deploy helper needs sudo (deploy-release.sh) and the repo/worktrees under $HOME.
# The AI itself is boxed separately (claude --restricted + tool allowlist + check.sh namespaces), see README.md.
[Unit]
Description=Death Muffin Discord dev agent (runner)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/ubuntu/death-muffin/discord-agent
ExecStart=/usr/bin/node /home/ubuntu/death-muffin/discord-agent/runner/server.cjs /home/ubuntu/death-muffin/discord-agent/config.json
ExecStop=/bin/bash /home/ubuntu/death-muffin/discord-agent/wait-for-ship.sh /home/ubuntu/death-muffin/discord-agent/state $MAINPID
TimeoutStopSec=85min
Restart=on-failure
RestartSec=10
PrivateTmp=yes
Nice=10

[Install]
WantedBy=multi-user.target
