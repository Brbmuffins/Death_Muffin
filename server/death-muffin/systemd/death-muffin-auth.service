[Unit]
Description=Death Muffin account and saved progression service
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/death-muffin/backend
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# team-jobs.cjs stores the team app's result pictures and clips here and runs /usr/bin/ffmpeg inside the job's folder to turn a clip into an mp4 (README "Team jobs"; /usr stays readable and executable under
# ProtectSystem=strict, the job's folder is the only place ffmpeg writes); the folder must exist before the service starts, `-` lets it start without
ReadWritePaths=-/home/ubuntu/death-muffin/team-results

[Install]
WantedBy=multi-user.target
