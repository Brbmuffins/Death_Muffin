[Unit]
Description=Death Muffin account and saved progression service
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/death-muffin/backend
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# team-jobs.cjs stores the team app's result pictures here (README "Team jobs"); the folder must exist before the service starts, `-` lets it start without
ReadWritePaths=-/home/ubuntu/death-muffin/team-results

[Install]
WantedBy=multi-user.target
