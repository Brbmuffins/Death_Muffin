<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>DeathMuffinTeam</AssemblyName>
    <RootNamespace>DeathMuffinTeam</RootNamespace>
    <!-- Three parts, always: the app compares it with the version.json on the game's site (SelfUpdate.cs). -->
    <Version>0.5.1</Version>
    <ApplicationIcon>Resources\DeathMuffin.ico</ApplicationIcon>
    <AssemblyTitle>Death Muffin Team</AssemblyTitle>
    <Product>Death Muffin Team</Product>
    <Description>Team PC helper for Death Muffin: runs the jobs that need a real graphics card</Description>
    <Copyright>Muffin Development</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <!-- 64-bit only: the game is, and reading another process's path (to tell the player's Death Muffin from a job's) needs the same bitness. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Lets the project restore and compile on Linux/macOS CI too (net48 reference assemblies, no Windows SDK needed). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <!-- The `model` job's ComfyUI workflow (teamapp/comfy/make-workflow.py makes it; ComfyWorkflow.Embedded reads it). -->
    <EmbeddedResource Include="..\comfy\image-to-model.json" LogicalName="image-to-model.json" />
  </ItemGroup>

</Project>
