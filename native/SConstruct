#!/usr/bin/env python
# Builds the combat core GDExtension into client/bin/. Run through `bash native/build.sh` (fetches the pinned godot-cpp first).
# Build records sit in each directory next to what they describe (SConsignFile(None)): godot-cpp's next to its objects in the shared cache
# (native/build.sh), so a new worktree finds them current instead of rebuilding them (about 6 minutes), and this checkout's next to its own
# objects. One shared database keyed by relative path would let a checkout link stale objects of its own that another checkout's records call
# current (2026-10-16). Builds take turns on the cache's lock.
SConsignFile(None)
env = SConscript("thirdparty/godot-cpp/SConstruct")
env.Append(CPPPATH=["src/"])
library = env.SharedLibrary(
    "../client/bin/libdmcore{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=Glob("src/*.cpp") + Glob("src/core/*.cpp"),
)
Default(library)
