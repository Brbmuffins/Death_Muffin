# Assets the rebuilt client copies from godot/assets/ (same relative paths), by tools/rebuild/sync-assets.mjs.
# One path or glob per line, relative to godot/assets/. `*` stays inside a folder, `**` crosses folders, a folder name copies it whole.
# Godot's *.import and *.uid files are never copied. Keep each block to what its scene or system uses; add a block when the next one starts.

# ---- The Hollow Graves (client/areas/graves.tscn): ground and wall textures
slice/art/textures/grave_soil.webp
slice/art/textures/flagstone.webp
slice/art/textures/stone_wall.webp

# ---- The Hollow Graves: props. `<name>*` is the model plus the textures Godot extracts from it (<name>_Color_/_NormalGL_/_ORM_*.webp).
slice/models/props/bone_pile*
slice/models/props/brazier*
slice/models/props/candles*
slice/models/props/coffin_stack*
slice/models/props/dead_tree*
slice/models/props/fence*
slice/models/props/gibbet_cage*
slice/models/props/grave_lantern*
slice/models/props/kings_grave*
slice/models/props/mausoleum*
slice/models/props/sarcophagus*
slice/models/props/statue*
slice/models/props/tombstone_cross*
slice/models/props/tombstone_round*
slice/models/props/waystone*

# ---- The Hollow Graves: gathering nodes (the Coffin-Oak and the Pauper's Grave in their live look)
slice/models/props/prop_node_burial_mound*
slice/models/props/prop_node_coffin_oak*

# ---- Crowd creatures (client/crowd/README.md): models the vertex-animation baker reads; the rest of the Graves roster joins with it.
slice/models/grave_robber
slice/models/bone_hound
# the thralls the rites raise (client/crowd/crowd_looks.json thrall_model / legion): the Gravecaller's legionnaire, the other legions' bodies, the risen skeleton
# (an archer, a bone mage), the plague bearer's sac and the Bone Colossus. skeleton_thrall, thrall_legionnaire, thrall_sentinel and thrall_plague are listed below with the people.
slice/models/carrion_sac
slice/models/bone_colossus

# ---- Code sync (client/code.list): what the copied scripts and scenes load. `@` lines are art that lives next to the code in godot/ (not under
# godot/assets); they land at the same path in client/. New files get a seed .import carrying the live asset's uid (tools/rebuild/sync-assets.mjs).

# Fonts of the UI theme (ui/dm_ui.gd, ui/theme/dm_theme.tres), the HUD kit's icons and ability art (ui/hud/dm_hud_kit.gd), the front flow's
# portraits and login backdrop (front/), the stained-glass window of the world dressing (world_fx/)
@ui/fonts
@ui/hud/art
@front/art
@world_fx/assets

# UI art by name: items, abilities, omens, portraits, skills, status icons, the loading key art (ui/dm_ui_art.gd, ui/widgets/dm_loading_screen.gd)
ui_art
game/art

# Effects: the Vfx autoload (fx/dm_fx.gd) reads the effect data, the flipbook and noise textures, the Binbun effect scenes and shaders, and the
# few effect meshes. The licensed flipbook sheets (fx/sheets) join with the rites that play them.
fx/fx_data.json
fx/tex
fx/art
fx/models
fx/binbun

# Sound: the AudioDirector autoload (audio/) loads clips from these folders by the audio map; the chat ding (audio/eleven) joins with the panel host
audio/esm
audio/ambience
audio/world
audio/combat
audio/music

# People: the three Covenant NPCs (next/chapterhouse/dm_hub_npcs.gd, data/content/npcs.json) and the four labourer models (game/dm_laborer_views.gd)
slice/models/npc_prior
slice/models/npc_sexton
slice/models/npc_apothecary
slice/models/skeleton_thrall
slice/models/thrall_legionnaire
slice/models/thrall_sentinel
slice/models/thrall_plague

# ---- The hero of the game scene (client/next/next_game.gd): the Gravecaller, the dev entry's character
slice/models/hero_gravecaller

# ---- The rites' licensed flipbook sheets (godot/fx/README.md "Flipbook sheets"): read from $FX_SHEETS, copied into the git-ignored client/assets/fx/sheets/. Without them
# the effects draw their plain look.
fx/sheets/hit_flash.png
fx/sheets/crit_burst.png
fx/sheets/crush_slam.png
fx/sheets/summon_circle.png
fx/sheets/chain_arc.png
fx/sheets/trail_arc.png

# ---- Later blocks (not listed yet): the other disciplines, the rest of the Graves roster, the Gravedigger King, the other areas' props, bosses.
