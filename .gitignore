node_modules
dist/
dist-offline/
.env
*.log
*.local.md
*.local
.ai-keys.local
server/web-deploy/*.tar.gz
art-src
audio-src
.claude/worktrees/
*.tsbuildinfo
__pycache__/

# launcher build output
launcher/windows/bin/
launcher/windows/obj/

# The old game's folder (DECISIONS B57; tag archive/old-game): frozen, nothing is added to it, and it goes next. Older checkouts can hold its build
# files and its copy of the licensed flipbook sheets there, which must never be committed.
/godot/

# The game (client/) and its C++ core (native/): godot-cpp is fetched by native/build.sh; built libraries are not committed
client/.godot/
# The QA driver's default folder for its pictures (`--shots=`, client/README.md "Screenshots for proposals")
/shots/
client/bin/*.so
client/bin/*.dll
# Licensed flipbook sheets are not redistributable in a public repo: tools/godot/fx-sheets-sync.sh copies them in from the private source (client/README.md).
client/assets/fx/sheets/
# Baked crowd models (client/crowd/README.md): megabytes each, generated by client/tools/bake_crowd.sh
client/assets/crowd/baked/
native/thirdparty/
# The Discord agent's own copy of godot-cpp, for a check of a change to the combat core (server/death-muffin/discord-agent/client-prep.sh)
.dm-native-cache/
# The Windows core's debug symbols (native/build.sh; the publish keeps them per build in ~/death-muffin/symbols/)
native/build/
native/**/*.os
native/**/*.o
native/.sconsign*.dblite
# per-directory build records (native/SConstruct)
native/**/.sconsign*
client/bin/.sconsign*
