{
  "maxFileMB": 20,
  "bigFileAllow": [],
  "scanExclude": [
    "client/data/**",
    "client/assets/**",
    "package-lock.json",
    "**/package-lock.json",
    "PATCH_NOTES.json",
    "server/death-muffin/discord-agent/test/**",
    "client/tests/**/fixtures/**"
  ],
  "terms": [
    {
      "id": "godot-next",
      "pattern": "(?<!archive/)godot-next",
      "reason": "branch deleted; tag archive/godot-next",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**",
        "client/tests/next_acre_guide/run.gd",
        "server/death-muffin/discord-agent/runner/lib/config.cjs",
        "client/next/hud/dm_next_ui_host.gd"
      ]
    },
    {
      "id": "godot-port",
      "pattern": "(?<!archive/)godot-port",
      "reason": "branch deleted; tag archive/godot-port",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**",
        "server/death-muffin/discord-agent/runner/lib/config.cjs"
      ]
    },
    {
      "id": "master-branch",
      "pattern": "(\\bbranch `?master\\b|origin/master\\b|\\bmaster branch\\b|`master`|\\bgit (checkout|merge|rebase|push|pull) [^\\n]*\\bmaster\\b)",
      "reason": "branch is main; master is an archive/* tag",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**"
      ]
    },
    {
      "id": "legacy-web",
      "pattern": "(?<!archive/)legacy-web",
      "reason": "only the tag archive/legacy-web exists",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**"
      ]
    },
    {
      "id": "gen-fixtures",
      "pattern": "gen-fixtures",
      "reason": "TS fixture generators were deleted",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**",
        "server/death-muffin/discord-agent/*"
      ]
    },
    {
      "id": "vite-node",
      "pattern": "vite-node",
      "reason": "no longer used",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**",
        "tools/godot/fx-binbun-rebuild.ts",
        "tools/godot/fx-binbun-unlit.ts"
      ]
    },
    {
      "id": "src-path",
      "pattern": "(?:^|[\\s`'\"(])src/",
      "reason": "root src/ (web game) was deleted",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**",
        "server/death-muffin/lobby/**",
        "launcher/**",
        "client/tests/common/dm_test_lobby.gd",
        "client/tests/relay/run.gd",
        "server/death-muffin/discord-agent/runner/lib/config.cjs"
      ]
    },
    {
      "id": "socket.io",
      "pattern": "socket\\.io",
      "flags": "gi",
      "reason": "realtime server was deleted; lobby uses plain WebSocket",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**"
      ]
    },
    {
      "id": "death-muffin-realtime",
      "pattern": "death-muffin-realtime",
      "reason": "realtime server was deleted",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**"
      ]
    },
    {
      "id": "port-5191",
      "pattern": ":5191\\b",
      "reason": "realtime port is gone; lobby is :5192",
      "allow": [
        "DECISIONS.md",
        "server/death-muffin/README.md",
        "tools/hygiene/**"
      ]
    },
    {
      "id": "old-docs",
      "pattern": "\\b(REBUILD|PARITY|PORTING|HANDOFF|LOOT-TABLES|BALANCE|FIRST_HOUR|CLARITY)\\.md",
      "reason": "doc was deleted",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**",
        "server/death-muffin/discord-agent/runner/lib/generated.cjs"
      ]
    },
    {
      "id": "offline-edition",
      "pattern": "offline edition",
      "flags": "gi",
      "reason": "there is no offline edition; --dev-offline is test-only",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**",
        "server/death-muffin/backend/authority.test.cjs",
        "server/death-muffin/discord-agent/preview.sh",
        "server/death-muffin/discord-agent/preview-godot.sh",
        "server/death-muffin/discord-agent/ship.sh",
        "server/death-muffin/discord-agent/runner/core.cjs",
        "server/death-muffin/discord-agent/runner/lib/config.cjs"
      ]
    },
    {
      "id": "acre-ledger",
      "pattern": "DmAcreLedger",
      "reason": "unused panel deleted 2026-10-10",
      "allow": [
        "tools/hygiene/**"
      ]
    },
    {
      "id": "necro-backdrop",
      "pattern": "DmNecroBackdrop|dm_necro_backdrop|backdrop_shot",
      "reason": "animated 3D login backdrop removed 2026-10-10 (owner: too busy, mouse-follow camera); login/char select use the still DmFrontUi.backdrop()",
      "allow": [
        "tools/hygiene/**"
      ]
    },
    {
      "id": "publish-test-build",
      "pattern": "publish-test-build",
      "reason": "side test-build script removed 2026-10-12 (Helix: builds go straight to main)",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**"
      ]
    },
    {
      "id": "gear-greenbone-mantle",
      "pattern": "gear_greenbone_mantle",
      "reason": "removed 2026-10-12: Soul Harbinger's Raiment shows its ribcage on the full legendary body (hero_leg_soul_harbingers), not as a bolted-on prop",
      "allow": [
        "tools/hygiene/**",
        "art-manifest/**"
      ]
    },
    {
      "id": "loot-filter",
      "pattern": "DmLootFilter|loot_filter\\.gd|gameplay_lootFilter|auto_looted|auto_sold",
      "reason": "Settings loot rules removed 2026-10-12 (DECISIONS B15: click to pick up)",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**"
      ]
    },
    {
      "id": "rune-pool-tag",
      "pattern": "\\brune_pool\\b",
      "reason": "rune drops no longer carry their source's pool: a known rune is always soul shards (DECISIONS B17, 2026-10-13)",
      "allow": [
        "tools/hygiene/**"
      ]
    },
    {
      "id": "known-rune-shards",
      "pattern": "KNOWN_RUNE_SHARDS",
      "reason": "a rune the player has does not drop at all, no shards (DECISIONS B17, 2026-10-13)",
      "allow": [
        "tools/hygiene/**"
      ]
    },
    {
      "id": "rune-resolve",
      "pattern": "\\brune_resolve\\b|\\b_resolve_rune\\b|\\brune_known\\b",
      "reason": "replaced by DmLootView.rune_owned: an owned rune does not drop (DECISIONS B17, 2026-10-13)",
      "allow": [
        "tools/hygiene/**"
      ]
    },
    {
      "id": "party-window-classes",
      "pattern": "\\bDmLobbyPanel\\b|\\bDmUiLobby\\b|\\blobby_ui\\b|dm_lobby_panel\\.gd|dm_ui_lobby\\.gd",
      "reason": "the Party window became the Social window's Party tab: DmPartyPane, DmSocialWindow, DmUiSocial / social_ui (DECISIONS B18, 2026-10-13)",
      "allow": [
        "tools/hygiene/**"
      ]
    },
    {
      "id": "party-codes-ui",
      "pattern": "\\bparty_code\\b|\\bclean_code\\b|\\bjoin_code_requested\\b|\\bopen_toggled\\b|\\bpublic_check\\b|\\bparty_set_open\\b|\\bcode_big\\b|\\bcopy_btn\\b|\\bparty_in\\b",
      "reason": "party codes left the client UI: friends join by invite / ask, parties are Open or Closed (DECISIONS B18, 2026-10-13)",
      "allow": [
        "tools/hygiene/**"
      ]
    },
    {
      "id": "client-bag-save",
      "pattern": "bag_save_part|check-bag-payload|sort_bag_slots|to_save_payload|remove_from_slot|bag_remove\\b|guardBagSave|trimSlots",
      "reason": "the client never saves or edits its bag (DECISIONS B25): bag changes are server operations (bag-ops.cjs and the other bag routes)",
      "allow": [
        "tools/hygiene/**",
        "client/tests/next_bag/run.gd"
      ]
    },
    {
      "id": "bug-agent",
      "pattern": "bug-agent|run-bug-agent|bugfix/reports-",
      "reason": "the 2-minute bug-fix agent is retired (DECISIONS B27): reports open #in-game-reports threads via the Discord agent's runner",
      "allow": [
        "tools/hygiene/**"
      ]
    },
    {
      "id": "prepare-live-project",
      "pattern": "prepare-live-project",
      "reason": "the test channel publishes the rebuilt client (prepare-rebuild.sh) since Gate A passed (2026-10-16)",
      "allow": [
        "tools/hygiene/**"
      ]
    },
    {
      "id": "rebuild-hud-host",
      "pattern": "\\bDmNextHud\\b|\\bDmNextSocial\\b|next/next_hud\\.gd|dm_next_social\\.gd",
      "reason": "the rebuilt client's own HUD host and Social host retired for today's DmGameUi on DmNextUiHost (DECISIONS B46); today's game keeps its DmNextHud",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**",
        "client/code.list"
      ]
    },
    {
      "id": "area-graves-test",
      "pattern": "area_graves\\.gd",
      "reason": "the Graves-only area test became tests/areas.gd, which checks every converted area",
      "allow": [
        "tools/hygiene/**"
      ]
    },
    {
      "id": "roadmap-rebuild-sections",
      "pattern": "ROADMAP[^\\n]{0,12}(\"(Now: the rebuild|After launch day|For review|Before numbers|Look pass|Static batching|Performance rules|The live game during the rebuild|2-player co-op)\"|Gates? [A-D]\\b|'s client layer|: client layer)",
      "reason": "ROADMAP.md was restructured on 2026-10-18 (DECISIONS B50): the rebuild's checklist and its sections are gone (git keeps them); bugs and gaps are in KNOWN-GAPS.md, ideas in ROADMAP \"Ideas\", the performance budgets in CLAUDE.md; client/crowd/crowd_baker.gd (and client/project.godot's header) keep their old pointer until their next real change: both feed the assets pack's fingerprint (publish-godot-client.sh), so a comment edit alone would make every player download the art again",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**",
        "client/crowd/crowd_baker.gd"
      ]
    },
    {
      "id": "old-game-folder",
      "pattern": "(?<![\\w.:-])(?<!\\w/)godot/(?!app_userdata\\b)",
      "reason": "the first Godot game's folder, deleted 2026-10-19 (B57): the game is client/; name a file of it as archive/old-game:godot/<path>",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**",
        ".gitignore",
        "server/death-muffin/lobby/src/server.js"
      ]
    },
    {
      "id": "team-bench-hook",
      "pattern": "team-bench\\.(sh|test\\.cjs)|\\bNO_TEAM_BENCH\\b|\\bTEAM_BENCH\\b|DM_TEAM_BENCH_DAYS",
      "reason": "the publish hook that queued the team PCs' benchmark became team-release.sh (the `release` job, whose `bench` step is the benchmark; env TEAM_RELEASE, NO_TEAM_RELEASE, DM_TEAM_RELEASE_DAYS), 2026-10-19",
      "allow": [
        "DECISIONS.md",
        "tools/hygiene/**"
      ]
    }
  ],
  "allowPaths": {
    "docs/AUDIO-SOURCES.md": [
      "tools/audio/build-esm.mjs",
      "public/audio/crossworlds/"
    ],
    "launcher/windows/README.md": [
      "launcher/windows/bin/Release/net48/DeathMuffinLauncher.exe"
    ]
  },
  "historyDocs": [
    "DECISIONS.md"
  ]
}
