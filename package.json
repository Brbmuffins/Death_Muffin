{
  "name": "crossworlds-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "node --test server/realtime/server.test.js server/vps-handoff/necro-progress/necro-progress.test.cjs server/death-muffin/backend/gathering/gathering.test.cjs server/death-muffin/backend/discipline.test.cjs server/death-muffin/backend/chronicle.test.cjs",
    "build:vfx": "node tools/binbun-port.mjs",
    "test:vfx": "node tools/binbun-port.test.mjs",
    "build:characters": "node tools/build-characters.mjs",
    "balance": "vite-node src/gameplay/balance/report.ts",
    "balance:boss": "vite-node src/gameplay/balance/bossReport.ts",
    "build:server-rules": "node tools/build-server-rules.mjs",
    "build:death-muffin": "DEPLOY_BASE=/death-muffin/play/ VITE_API_BASE=/death-muffin/api VITE_WS_BASE=https://muffindevelopment.com VITE_WS_PATH=/death-muffin/rt/socket.io npm run build"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "socket.io-client": "^4.8.3",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.1",
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/three": "^0.166.0",
    "fbx2gltf": "^0.9.7-p1",
    "meshoptimizer": "^1.2.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "sharp@0.34.5": true
  }
}
