class_name DmPaData
extends RefCounted
## Loader + helpers for godot/data/panels_a/*.json (generated by tools/godot/export-panels-a.ts from the real TS: the Codex's computed
## rows and the Gear Atlas model). Static cache; do not mutate what it returns.

const DIR := "res://data/panels_a/"
static var _cache: Dictionary = {}


static func load_json(name: String) -> Dictionary:
	if _cache.has(name):
		return _cache[name]
	var path := DIR + name + ".json"
	var out: Dictionary = {}
	if FileAccess.file_exists(path):
		var f := FileAccess.open(path, FileAccess.READ)
		var v: Variant = JSON.parse_string(f.get_as_text())
		if typeof(v) == TYPE_DICTIONARY:
			out = v
	else:
		push_error("DmPaData: missing %s (run npx vite-node tools/godot/export-panels-a.ts)" % path)
	_cache[name] = out
	return out


static func codex_rows() -> Dictionary:
	return load_json("codex_rows")


static func atlas() -> Dictionary:
	return load_json("atlas")


## Unpack a packed drop-source row (see export-panels-a.ts packSrc) into the TS DropSource shape.
static func src(row: Array) -> Dictionary:
	var d := {
		"kind": row[0], "placeId": row[1], "place": row[2], "event": row[3], "chance": float(row[4]),
		"qty": [int(row[5]), int(row[6])],
	}
	if String(row[7]) != "":
		d["area"] = row[7]
	if String(row[8]) != "":
		d["ilvlSource"] = row[8]
	if String(row[9]) != "":
		d["note"] = row[9]
	return d


static func srcs(rows: Variant) -> Array:
	var out: Array = []
	if typeof(rows) == TYPE_ARRAY:
		for r in rows:
			out.append(src(r))
	return out


## Drop sources of an item for a discipline (sourcesFor): the shared list unless smart loot tilts it for that discipline.
static func sources_for(item_id: String, disc: String) -> Array:
	var a := atlas()
	var bd: Dictionary = a.get("by_disc", {}).get(disc, {})
	var v: String = bd.get("sources_variant", "")
	var diff: Dictionary = a.get("source_variants", {}).get(v, {})
	if diff.has(item_id):
		return srcs(diff[item_id])
	return srcs(a.get("sources", {}).get(item_id, []))


## The class's rite data helpers (abilities.ts): unlock level and roles.
static func unlock_level(id: String) -> int:
	var lv: Variant = DmContent.computed("abilityUnlockLevels")
	if typeof(lv) == TYPE_DICTIONARY and (lv as Dictionary).has(id):
		return int(lv[id])
	return int(DmContent.ability(id).get("unlockLevel", 1))


static func roles_of(id: String) -> Array:
	var r: Variant = DmContent.get_export("abilities", "RITE_ROLES")
	if typeof(r) == TYPE_DICTIONARY and (r as Dictionary).has(id):
		return r[id]
	return []


## Rune data (runes.ts): which rites take runes, and each rune's rite/order.
static func is_rune_rite(id: String) -> bool:
	return (DmContent.get_export("runes", "RUNE_RITES") as Array).has(id)


## Rune ids that fit a rite, in RUNE_ORDER.
static func runes_for(rite: String) -> Array:
	var out: Array = []
	for rid in DmContent.get_export("runes", "RUNE_ORDER"):
		if String(DmContent.rune(rid).get("rite", "")) == rite:
			out.append(rid)
	return out


## rune id -> "where it drops" text (runeSources), from the Codex rows.
static var _rune_sources: Dictionary = {}


static func rune_sources() -> Dictionary:
	if _rune_sources.is_empty():
		for g in codex_rows().get("runes", []):
			for r in g["runes"]:
				_rune_sources[String(r["id"])] = String(r["sources"])
	return _rune_sources
