extends SceneTree
## BinbunVFX evaluation harness (tooling only; vendor content is never committed). Runs INSIDE one per-pack eval project generated by
## tools/godot/fx-eval-setup.sh (res://assets -> /home/ubuntu/death-muffin/private/binbun/<Pack>/assets). Usage:
##   godot --path <proj> --script res://eval_fx.gd -- --mode=static|perf|shots|shaders --out=<file|dir> [--only=substr]
## static: headless-safe analysis JSON.  perf: per-effect Performance monitors x1 / x10 (needs a renderer).  shots: contact sheets (3x2).
## shaders: loads/applies every non-effect .gdshader on a sphere or rect and sheets them.  Markers "@@FX <name>" bracket stderr errors.

var mode := "static"
var out := ""
var only := ""
var W := 800
var H := 450

func _arg(k: String, d := "") -> String:
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--" + k + "="):
			return a.substr(k.length() + 3)
	return d

func _initialize() -> void:
	mode = _arg("mode", "static")
	out = _arg("out", "/tmp/fx_eval.json")
	only = _arg("only", "")
	_main.call_deferred()

func _main() -> void:
	match mode:
		"static": await _static()
		"perf": await _perf()
		"shots": await _shots()
		"shaders": await _shaders()
		"synth": await _synth()
	quit(0)

# ---------------------------------------------------------------- discovery
func effect_paths() -> Array:
	var res: Array = []
	_scan("res://assets", res)
	res.sort()
	var f: Array = []
	for p in res:
		if (only == "" or only in p) and (mode == "static" or not p.ends_with("_demo.tscn")):
			f.append(p)
	return f

func _scan(dir: String, res: Array) -> void:
	var d := DirAccess.open(dir)
	if d == null:
		return
	for s in d.get_directories():
		_scan(dir + "/" + s, res)
	for fn in d.get_files():
		if fn.ends_with(".tscn") and "/effects/" in (dir + "/"):
			res.append(dir + "/" + fn)

func shader_paths() -> Array:
	var res: Array = []
	_scan_ext("res://assets", ".gdshader", res)
	res.sort()
	return res

func _scan_ext(dir: String, ext: String, res: Array) -> void:
	var d := DirAccess.open(dir)
	if d == null:
		return
	for s in d.get_directories():
		_scan_ext(dir + "/" + s, ext, res)
	for fn in d.get_files():
		if fn.ends_with(ext):
			res.append(dir + "/" + fn)

# ---------------------------------------------------------------- shader text analysis
var _shader_cache: Dictionary = {}

func shader_info(sh: Shader) -> Dictionary:
	if sh == null:
		return {}
	var key := sh.resource_path
	if key != "" and _shader_cache.has(key):
		return _shader_cache[key]
	var code := _expand(sh.code, 0)
	var info := {
		"path": key, "lines": code.count("\n"),
		"tex": _count(code, "texture(") + _count(code, "textureLod(") + _count(code, "texelFetch("),
		"loops": _count(code, "for (") + _count(code, "for("),
		"screen": ("hint_screen_texture" in code), "depth": ("hint_depth_texture" in code),
		"stencil": ("stencil" in code), "discard": ("discard" in code),
		"noise_fn": _count(code, "noise(") + _count(code, "fbm(") + _count(code, "hash("),
		"unshaded": ("unshaded" in code), "blend_add": ("blend_add" in code),
		"particles_type": ("shader_type particles" in code), "canvas": ("shader_type canvas_item" in code),
		"sky": ("shader_type sky" in code),
	}
	info["score"] = float(info["tex"]) + 3.0 * info["loops"] + (3.0 if info["screen"] else 0.0) + (3.0 if info["depth"] else 0.0) + 0.5 * info["noise_fn"] + info["lines"] / 30.0
	if key != "":
		_shader_cache[key] = info
	return info

func _count(s: String, sub: String) -> int:
	return s.count(sub)

func _expand(code: String, depth: int) -> String:
	if depth > 4:
		return code
	var out_s := ""
	for line in code.split("\n"):
		var t := line.strip_edges()
		if t.begins_with("#include"):
			var q := t.split("\"")
			if q.size() >= 2 and FileAccess.file_exists(q[1]):
				out_s += _expand(FileAccess.get_file_as_string(q[1]), depth + 1) + "\n"
				continue
		out_s += line + "\n"
	return out_s

# ---------------------------------------------------------------- static analysis
func _mat_shader(m: Material) -> Shader:
	if m is ShaderMaterial:
		return (m as ShaderMaterial).shader
	return null

func analyze_node(root: Node) -> Dictionary:
	var d := {"particles": [], "meshes": [], "lights": [], "anims": {}, "shaders": [], "notes": []}
	var seen := {}
	_walk(root, d, seen)
	var total_amount := 0
	var area := 0.0
	var emitters := 0
	var trails := 0
	var subem := 0
	var max_life := 0.0
	var tex := 0
	var score := 0.0
	var lights_n := 0
	var screen := false
	var depth := false
	var stencil := false
	for p in d["particles"]:
		total_amount += p["amount"]
		emitters += 1
		area += p["area_total"]
		if p["trail"]: trails += 1
		if p["subemit"]: subem += 1
		max_life = maxf(max_life, p["lifetime"])
		score += p["amount"] * p["shader_score"] * 0.02
	for m in d["meshes"]:
		area += m["area"]
		score += m["shader_score"] * 0.3
	for sh in d["shaders"]:
		tex += sh["tex"]
		screen = screen or sh["screen"]
		depth = depth or sh["depth"]
		stencil = stencil or sh["stencil"]
	d["amount"] = total_amount
	d["emitters"] = emitters
	d["mesh_count"] = d["meshes"].size()
	d["draw_nodes"] = emitters + d["meshes"].size()
	d["alpha_area_m2"] = snappedf(area, 0.01)
	d["trails"] = trails
	d["subemitters"] = subem
	d["max_particle_life"] = snappedf(max_life, 0.01)
	d["tex_samples"] = tex
	d["lights"] = d["lights"].size()
	d["uses_screen"] = screen
	d["uses_depth"] = depth
	d["uses_stencil"] = stencil
	d["static_score"] = snappedf(score, 0.1)
	return d

func _walk(n: Node, d: Dictionary, seen: Dictionary) -> void:
	if n is GPUParticles3D:
		var p := n as GPUParticles3D
		var pm := p.process_material as ParticleProcessMaterial
		var smin := 1.0
		var smax := 1.0
		if pm:
			smin = pm.scale_min
			smax = pm.scale_max
		var mesh := p.draw_pass_1
		var face := 0.0
		var mcls := ""
		if mesh:
			mcls = mesh.get_class()
			var a := mesh.get_aabb().size
			face = maxf(a.x * a.y, maxf(a.x * a.z, a.y * a.z))
		var sc := (smin + smax) * 0.5
		var mat: Material = p.material_override
		if mat == null and mesh and mesh.get_surface_count() > 0:
			mat = mesh.surface_get_material(0)
		var sh := _mat_shader(mat)
		var si := shader_info(sh)
		if sh and not seen.has(sh):
			seen[sh] = true
			d["shaders"].append(si)
		var sub := false
		if pm:
			sub = pm.sub_emitter_mode != ParticleProcessMaterial.SUB_EMITTER_DISABLED
		d["particles"].append({
			"name": str(n.name), "amount": p.amount, "lifetime": p.lifetime, "one_shot": p.one_shot, "explosiveness": p.explosiveness,
			"trail": p.trail_enabled, "subemit": sub, "local": p.local_coords, "mesh": mcls, "face_area": snappedf(face, 0.001), "scale": sc,
			"area_total": p.amount * face * sc * sc * (1.0 if mcls == "QuadMesh" else 0.6), "shader": si.get("path", ""), "shader_score": si.get("score", 1.0),
			"emitting0": p.emitting, "passes": p.draw_passes, "draw_order": p.draw_order,
		})
	elif n is MeshInstance3D:
		var mi := n as MeshInstance3D
		var mat: Material = mi.material_override
		if mat == null and mi.mesh and mi.mesh.get_surface_count() > 0:
			mat = mi.get_active_material(0)
		var sh := _mat_shader(mat)
		var si := shader_info(sh)
		if sh and not seen.has(sh):
			seen[sh] = true
			d["shaders"].append(si)
		var a := mi.mesh.get_aabb().size if mi.mesh else Vector3.ZERO
		d["meshes"].append({"name": str(n.name), "mesh": mi.mesh.get_class() if mi.mesh else "", "area": snappedf(maxf(a.x * a.y, maxf(a.x * a.z, a.y * a.z)), 0.01),
			"shader": si.get("path", ""), "shader_score": si.get("score", 1.0), "surfaces": mi.mesh.get_surface_count() if mi.mesh else 0})
	elif n is Light3D:
		d["lights"].append({"energy": (n as Light3D).light_energy, "shadow": (n as Light3D).shadow_enabled})
	elif n is AnimationPlayer:
		var ap := n as AnimationPlayer
		for a in ap.get_animation_list():
			var an := ap.get_animation(a)
			d["anims"][a] = {"len": snappedf(an.length, 0.01), "loop": an.loop_mode}
	for c in n.get_children():
		_walk(c, d, seen)

func _static() -> void:
	var res: Dictionary = {}
	for path in effect_paths():
		print("@@FX ", path)
		var e := {"path": path, "ok": false}
		var ps := load(path) as PackedScene
		if ps == null:
			e["error"] = "load failed"
			res[path] = e
			continue
		var inst := ps.instantiate()
		if inst == null:
			e["error"] = "instantiate failed"
			res[path] = e
			continue
		e["ok"] = true
		e["root_script"] = inst.get_script().resource_path if inst.get_script() else ""
		var an := analyze_node(inst)
		e.merge(an)
		var kind := "looper"
		var dur := -1.0
		if an["anims"].has("oneshot"):
			kind = "oneshot"
			dur = an["anims"]["oneshot"]["len"]
		elif an["anims"].has("main"):
			kind = "looper"
		else:
			var allone: bool = an["particles"].size() > 0
			for p in an["particles"]:
				if not p["one_shot"]:
					allone = false
			if allone:
				kind = "oneshot"
				dur = an["max_particle_life"]
		e["kind"] = kind
		e["duration"] = dur
		var aabb := _aabb(inst)
		e["aabb"] = [snappedf(aabb.size.x, 0.1), snappedf(aabb.size.y, 0.1), snappedf(aabb.size.z, 0.1)]
		inst.free()
		res[path] = e
	_write(res)

func _aabb(n: Node) -> AABB:
	var box := AABB(Vector3.ZERO, Vector3.ZERO)
	var first := true
	for c in _all(n):
		var bb := AABB()
		if c is GPUParticles3D:
			bb = (c as GPUParticles3D).visibility_aabb
			if (c as GPUParticles3D).draw_pass_1 and bb.size == Vector3.ZERO:
				bb = (c as GPUParticles3D).draw_pass_1.get_aabb()
		elif c is MeshInstance3D and (c as MeshInstance3D).mesh:
			bb = (c as MeshInstance3D).mesh.get_aabb()
		else:
			continue
		bb = (c as Node3D).transform * bb
		if first:
			box = bb
			first = false
		else:
			box = box.merge(bb)
	return box

func _all(n: Node) -> Array:
	var r: Array = [n]
	for c in n.get_children():
		r.append_array(_all(c))
	return r

func _write(o) -> void:
	DirAccess.make_dir_recursive_absolute(out.get_base_dir())
	var f := FileAccess.open(out, FileAccess.WRITE)
	f.store_string(JSON.stringify(o, "  "))
	f.close()

# ---------------------------------------------------------------- playing
func start_effect(inst: Node) -> void:
	if "autoplay" in inst:
		inst.set("autoplay", false)

func is_ctrl(inst: Node) -> bool:
	return inst.has_method("_reset_particles") and inst.has_method("play") and ("reset_particles" in inst)

func play_effect(inst: Node, kind: String) -> void:
	var ap := inst.get_node_or_null("AnimationPlayer") as AnimationPlayer
	if kind == "oneshot" and ap and ap.has_animation("oneshot"):
		if inst.has_method("_reset_particles"):
			inst.call("_reset_particles")
		ap.play("oneshot")
	elif ap and ap.has_animation("main"):
		if is_ctrl(inst):
			inst.call("play")
		else:
			ap.play("main")
	elif inst.has_method("play"):
		inst.call("play")
	elif inst.has_method("open"):
		inst.call("open")
	if ap and ap.current_animation == "" and ap.has_animation("main") and not (is_ctrl(inst)):
		ap.play("main")

func make_world(vp: Node, size: Vector2i) -> Camera3D:
	var env := Environment.new()
	env.background_mode = Environment.BG_COLOR
	env.background_color = Color(0.02, 0.02, 0.03)
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.ambient_light_color = Color(0.25, 0.25, 0.3)
	env.glow_enabled = true
	env.glow_intensity = 0.6
	env.glow_bloom = 0.1
	var we := WorldEnvironment.new()
	we.environment = env
	vp.add_child(we)
	var sun := DirectionalLight3D.new()
	sun.rotation_degrees = Vector3(-50, 30, 0)
	sun.light_energy = 0.5
	vp.add_child(sun)
	var ground := MeshInstance3D.new()
	var pm := PlaneMesh.new()
	pm.size = Vector2(60, 60)
	ground.mesh = pm
	var gm := StandardMaterial3D.new()
	gm.albedo_color = Color(0.06, 0.06, 0.07)
	gm.roughness = 1.0
	ground.material_override = gm
	vp.add_child(ground)
	var cam := Camera3D.new()
	cam.fov = 55
	cam.position = Vector3(0, 3.5, 7)
	cam.look_at_from_position(cam.position, Vector3(0, 1, 0))
	vp.add_child(cam)
	cam.current = true
	return cam

func frame_camera(cam: Camera3D, area_m2: float) -> void:
	var r := clampf(sqrt(maxf(area_m2, 1.0)) * 0.28, 1.7, 6.5)
	cam.fov = 50
	cam.look_at_from_position(Vector3(0, r * 0.8 + 1.4, r * 1.8 + 2.6), Vector3(0, r * 0.18 + 0.4, 0))

## --variant=lowres: subdivided quad/plane meshes cut to 3x3 and lights removed (the mitigations proposed in EVAL.md).
func apply_variant(inst: Node) -> void:
	var v := _arg("variant", "")
	if v == "":
		return
	for c in _all(inst):
		if c is Light3D:
			c.visible = false
		var meshes: Array = []
		if c is GPUParticles3D:
			meshes.append((c as GPUParticles3D).draw_pass_1)
		elif c is MeshInstance3D:
			meshes.append((c as MeshInstance3D).mesh)
		for m in meshes:
			if m is PlaneMesh:
				(m as PlaneMesh).subdivide_width = mini((m as PlaneMesh).subdivide_width, 3)
				(m as PlaneMesh).subdivide_depth = mini((m as PlaneMesh).subdivide_depth, 3)
			elif m is SphereMesh:
				(m as SphereMesh).radial_segments = mini((m as SphereMesh).radial_segments, 12)
				(m as SphereMesh).rings = mini((m as SphereMesh).rings, 6)

# ---------------------------------------------------------------- perf
func _perf() -> void:
	DisplayServer.window_set_size(Vector2i(W, H))
	root.size = Vector2i(W, H)
	var world := Node3D.new()
	root.add_child(world)
	make_world(world, Vector2i(W, H))
	var static_path := _arg("static", "")
	var smap: Dictionary = {}
	if static_path != "" and FileAccess.file_exists(static_path):
		smap = JSON.parse_string(FileAccess.get_file_as_string(static_path))
	var res: Dictionary = {}
	await _frames(20)
	for path in effect_paths():
		print("@@FX ", path)
		var ps := load(path) as PackedScene
		if ps == null:
			continue
		var kind: String = smap.get(path, {}).get("kind", "oneshot")
		var rec := {"path": path, "kind": kind}
		var base := await _measure(world, null, 1, kind, 12)
		for n in [1, 10]:
			var m := await _measure(world, ps, n, kind, 40)
			rec["x%d" % n] = m
		rec["base"] = base
		res[path] = rec
	_write(res)

func _frames(n: int) -> void:
	for i in n:
		await process_frame

func _measure(world: Node3D, ps: PackedScene, n: int, kind: String, frames: int) -> Dictionary:
	var nodes: Array = []
	if ps:
		for i in n:
			var inst := ps.instantiate()
			start_effect(inst)
			apply_variant(inst)
			var ang := TAU * i / maxf(n, 1)
			inst.position = Vector3(cos(ang), 0, sin(ang)) * (0.0 if n == 1 else 2.2)
			world.add_child(inst)
			play_effect(inst, kind)
			nodes.append(inst)
	await _frames(4)
	var dts: Array = []
	var dc := 0
	var obj := 0
	var prim := 0
	var t0 := Time.get_ticks_usec()
	for i in frames:
		await process_frame
		var t1 := Time.get_ticks_usec()
		if i >= 2:
			dts.append((t1 - t0) / 1000.0)
			dc = maxi(dc, int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)))
			obj = maxi(obj, int(Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME)))
			prim = maxi(prim, int(Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME)))
		t0 = t1
	dts.sort()
	var sum := 0.0
	for v in dts:
		sum += v
	var out_d := {
		"ms_mean": snappedf(sum / maxf(dts.size(), 1), 0.1), "ms_p95": snappedf(dts[int(dts.size() * 0.95)] if dts.size() else 0.0, 0.1),
		"draw_calls": dc, "objects": obj, "prims": prim,
		"vram_mb": snappedf(Performance.get_monitor(Performance.RENDER_VIDEO_MEM_USED) / 1048576.0, 0.1),
		"process_ms": snappedf(Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0, 0.01),
	}
	for nd in nodes:
		nd.queue_free()
	await _frames(3)
	return out_d

# ---------------------------------------------------------------- shots
func _label(txt: String, pos: Vector2) -> Label:
	var l := Label.new()
	l.text = txt
	l.position = pos
	l.add_theme_font_size_override("font_size", 15)
	l.add_theme_color_override("font_color", Color(1, 1, 0.7))
	l.add_theme_color_override("font_outline_color", Color(0, 0, 0))
	l.add_theme_constant_override("outline_size", 4)
	return l

func _is_short(sm: Dictionary) -> bool:
	var an: Dictionary = sm.get("anims", {})
	if sm.get("kind", "oneshot") == "oneshot":
		return float(sm.get("duration", 1.5)) <= 2.2
	return an.has("main") and float(an["main"]["len"]) <= 1.6 and sm.get("max_particle_life", 1.0) <= 1.6

## Long-exposure composite (max per channel) so a 0.3 s impact is visible however the capture lines up.
func _max_into(acc: Image, img: Image) -> void:
	var a := acc.get_data()
	var b := img.get_data()
	for i in a.size():
		if b[i] > a[i]:
			a[i] = b[i]
	acc.set_data(acc.get_width(), acc.get_height(), false, acc.get_format(), a)

func _shots() -> void:
	var CW := 640
	var CH := 540
	DisplayServer.window_set_size(Vector2i(CW * 3, CH * 2))
	root.size = Vector2i(CW * 3, CH * 2)
	var static_path := _arg("static", "")
	var smap: Dictionary = {}
	if static_path != "" and FileAccess.file_exists(static_path):
		smap = JSON.parse_string(FileAccess.get_file_as_string(static_path))
	var paths := effect_paths()
	var shorts: Array = []
	var longs: Array = []
	for p in paths:
		if _is_short(smap.get(p, {})):
			shorts.append(p)
		else:
			longs.append(p)
	var pack := _arg("pack", "pack")
	var sheet := 0
	for cls in ["short", "long"]:
		var list: Array = shorts if cls == "short" else longs
		var i := 0
		while i < list.size():
			var group := list.slice(i, i + 6)
			i += 6
			var ui := Control.new()
			root.add_child(ui)
			var vps: Array = []
			for k in group.size():
				var path: String = group[k]
				var sm: Dictionary = smap.get(path, {})
				var kind: String = sm.get("kind", "oneshot")
				var dur: float = sm.get("duration", 1.5)
				var svc := SubViewportContainer.new()
				svc.position = Vector2((k % 3) * CW, (k / 3) * CH)
				svc.size = Vector2(CW, CH)
				svc.stretch = true
				var sv := SubViewport.new()
				sv.size = Vector2i(CW, CH)
				sv.own_world_3d = true
				sv.render_target_update_mode = SubViewport.UPDATE_ALWAYS
				svc.add_child(sv)
				ui.add_child(svc)
				var cam := make_world(sv, Vector2i(CW, CH))
				frame_camera(cam, float(sm.get("alpha_area_m2", 20.0)))
				vps.append(sv)
				ui.add_child(_label("%s  [%s%s%s]" % [path.get_file().get_basename(), kind, " %.1fs" % dur if dur > 0 else "", ", long-exposure" if cls == "short" else ""], Vector2((k % 3) * CW + 6, (k / 3) * CH + 4)))
			for k in group.size():
				print("@@FX ", group[k])
				var inst := (load(group[k]) as PackedScene).instantiate()
				start_effect(inst)
				vps[k].add_child(inst)
				play_effect(inst, smap.get(group[k], {}).get("kind", "oneshot"))
			var dt := 1.0 / 30.0
			var caps: Array = [0.1, 0.2, 0.32, 0.5, 0.75, 1.1] if cls == "short" else [2.2]
			var acc: Image = null
			var f := 0
			for t in caps:
				while f * dt < t:
					await process_frame
					f += 1
				await process_frame
				f += 1
				var img := root.get_texture().get_image()
				if acc == null:
					acc = img
				else:
					_max_into(acc, img)
			DirAccess.make_dir_recursive_absolute(out)
			acc.save_png("%s/%s_%02d.png" % [out, pack, sheet])
			sheet += 1
			ui.queue_free()
			await _frames(3)

# ---------------------------------------------------------------- non-effect shader smoke
func _shaders() -> void:
	var CW := 480
	var CH := 360
	DisplayServer.window_set_size(Vector2i(CW * 4, CH * 3))
	root.size = Vector2i(CW * 4, CH * 3)
	var paths := shader_paths()
	var report: Dictionary = {}
	var pack := _arg("pack", "pack")
	var sheet := 0
	var i := 0
	while i < paths.size():
		var group := paths.slice(i, i + 12)
		i += 12
		var ui := Control.new()
		root.add_child(ui)
		for k in group.size():
			var path: String = group[k]
			print("@@FX ", path)
			var sh := load(path) as Shader
			var info := shader_info(sh)
			report[path] = info
			if sh == null:
				continue
			var svc := SubViewportContainer.new()
			svc.position = Vector2((k % 4) * CW, (k / 4) * CH)
			svc.size = Vector2(CW, CH)
			svc.stretch = true
			var sv := SubViewport.new()
			sv.size = Vector2i(CW, CH)
			sv.own_world_3d = true
			sv.render_target_update_mode = SubViewport.UPDATE_ALWAYS
			svc.add_child(sv)
			ui.add_child(svc)
			if info.get("canvas", false):
				var cr := ColorRect.new()
				cr.size = Vector2(CW, CH)
				var mt := ShaderMaterial.new()
				mt.shader = sh
				cr.material = mt
				sv.add_child(cr)
			elif info.get("particles_type", false) or info.get("sky", false):
				pass
			else:
				var cam := make_world(sv, Vector2i(CW, CH))
				cam.look_at_from_position(Vector3(0, 1.2, 3.2), Vector3(0, 0.6, 0))
				var mi := MeshInstance3D.new()
				mi.mesh = SphereMesh.new()
				mi.position = Vector3(0, 0.8, 0)
				var mt := ShaderMaterial.new()
				mt.shader = sh
				mi.material_override = mt
				sv.add_child(mi)
			ui.add_child(_label(path.get_file(), Vector2((k % 4) * CW + 4, (k / 4) * CH + 4)))
		await _frames(30)
		var img := root.get_texture().get_image()
		DirAccess.make_dir_recursive_absolute(out.get_base_dir())
		img.save_png("%s_%02d.png" % [out.get_basename(), sheet])
		sheet += 1
		ui.queue_free()
		await _frames(3)
	_write(report)

# ---------------------------------------------------------------- synthetic micro-benchmarks (what does X cost on gl_compatibility)
const SH_PLAIN := "shader_type spatial; render_mode unshaded, blend_add, depth_draw_never, cull_disabled;
uniform vec4 col : source_color = vec4(0.4,0.2,0.1,1);
void fragment(){ ALBEDO = col.rgb; ALPHA = 0.25; }"
const SH_DEPTH := "shader_type spatial; render_mode unshaded, blend_add, depth_draw_never, cull_disabled;
uniform sampler2D depth_tex : hint_depth_texture, repeat_disable, filter_nearest;
uniform vec4 col : source_color = vec4(0.4,0.2,0.1,1);
void fragment(){ float d = texture(depth_tex, SCREEN_UV).r; float z = (PROJECTION_MATRIX[3][2]/(d*2.0-1.0+PROJECTION_MATRIX[2][2])); float f = clamp((-VERTEX.z - z)*0.0 + 1.0, 0.0, 1.0); ALBEDO = col.rgb; ALPHA = 0.25*f; }"
const SH_NOISE := "shader_type spatial; render_mode unshaded, blend_add, depth_draw_never, cull_disabled;
uniform sampler2D n1; uniform sampler2D n2; uniform vec4 col : source_color = vec4(0.4,0.2,0.1,1);
void fragment(){ float a = texture(n1, UV*2.0+TIME*0.1).r * texture(n2, UV*3.0-TIME*0.07).r; ALBEDO = col.rgb; ALPHA = a*0.5; }"

func _quads(world: Node3D, n: int, sub: int, sh: String, size: float) -> Array:
	var out_a: Array = []
	var shader := Shader.new()
	shader.code = sh
	var noise := NoiseTexture2D.new()
	noise.noise = FastNoiseLite.new()
	noise.width = 256
	noise.height = 256
	for i in n:
		var mi := MeshInstance3D.new()
		var q := QuadMesh.new()
		q.size = Vector2(size, size)
		q.subdivide_width = sub
		q.subdivide_depth = sub
		mi.mesh = q
		var m := ShaderMaterial.new()
		m.shader = shader
		m.set_shader_parameter("n1", noise)
		m.set_shader_parameter("n2", noise)
		mi.material_override = m
		mi.position = Vector3(randf_range(-1.5, 1.5), 1.2 + randf() * 0.3, randf_range(-1, 1))
		world.add_child(mi)
		out_a.append(mi)
	return out_a

func _synth() -> void:
	DisplayServer.window_set_size(Vector2i(W, H))
	root.size = Vector2i(W, H)
	var world := Node3D.new()
	root.add_child(world)
	make_world(world, Vector2i(W, H))
	await _frames(20)
	var res: Dictionary = {}
	var base := await _measure(world, null, 1, "oneshot", 30)
	res["empty"] = base
	var cases := [
		["quad4m_x10_plain_sub1", 10, 1, SH_PLAIN, 4.0], ["quad4m_x10_plain_sub32", 10, 32, SH_PLAIN, 4.0],
		["quad4m_x10_depthtex_sub1", 10, 1, SH_DEPTH, 4.0], ["quad4m_x1_depthtex_sub1", 1, 1, SH_DEPTH, 4.0],
		["quad4m_x1_plain_sub1", 1, 1, SH_PLAIN, 4.0],
		["quad4m_x10_2noise_sub1", 10, 1, SH_NOISE, 4.0], ["quad8m_x10_plain_sub1", 10, 1, SH_PLAIN, 8.0], ["quad8m_x10_2noise_sub1", 10, 1, SH_NOISE, 8.0],
	]
	for c in cases:
		var nodes := _quads(world, c[1], c[2], c[3], c[4])
		await _frames(4)
		res[c[0]] = await _frames_stat(30)
		for nd in nodes:
			nd.queue_free()
		await _frames(3)
	for nl in [1, 4, 10]:
		var lights: Array = []
		for i in nl:
			var l := OmniLight3D.new()
			l.omni_range = 6.0
			l.light_energy = 3.0
			l.position = Vector3(randf_range(-2, 2), 1.0, randf_range(-2, 2))
			world.add_child(l)
			lights.append(l)
		await _frames(4)
		res["omni_x%d_over_ground" % nl] = await _frames_stat(30)
		for l in lights:
			l.queue_free()
		await _frames(3)
	res["__base_ms"] = base["ms_mean"]
	_write(res)

func _frames_stat(frames: int) -> Dictionary:
	var dts: Array = []
	var dc := 0
	var prim := 0
	var t0 := Time.get_ticks_usec()
	for i in frames:
		await process_frame
		var t1 := Time.get_ticks_usec()
		if i >= 2:
			dts.append((t1 - t0) / 1000.0)
			dc = maxi(dc, int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)))
			prim = maxi(prim, int(Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME)))
		t0 = t1
	var sum := 0.0
	for v in dts:
		sum += v
	return {"ms_mean": snappedf(sum / maxf(dts.size(), 1), 0.1), "draw_calls": dc, "prims": prim}
