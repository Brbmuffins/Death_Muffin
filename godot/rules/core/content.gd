## SPELL_FX: family -> ability id -> colours/fx data
static func spell_fx() -> Dictionary:
	return _dict("abilities", "SPELL_FX")


static func disciplines() -> Dictionary:
	return _dict("disciplines", "DISCIPLINES")


static func discipline(id: String) -> Dictionary:
	return disciplines().get(id, {})


## Kit (hotbar/grimoire/defaults) for a class family, baked from kitFor().
static func kit(family: String) -> Dictionary:
	return _dict("computed", "kits").get(family, {})


static func runes() -> Dictionary:
	return _dict("runes", "RUNES")


static func rune(id: String) -> Dictionary:
	return runes().get(id, {})


static func brews() -> Dictionary:
	return _dict("brews", "BREWS")


static func brew(id: String) -> Dictionary:
	return brews().get(id, {})


static func armor_sets() -> Dictionary:
	return _dict("armorSets", "ARMOR_SETS")


static func ascended_armor_sets() -> Dictionary:
	return _dict("armorSets", "ASCENDED_ARMOR_SETS")


static func legendary_sets() -> Dictionary:
	return _dict("legendarySets", "LEGENDARY_SETS")


static func set_bonuses() -> Dictionary:
	return _dict("setBonuses", "SET_BONUSES")


static func necro_weapons() -> Array:
	return get_export("necroWeapons", "NECRO_WEAPONS")


static func vows() -> Dictionary:
	return _dict("ascension", "VOWS")


static func boons() -> Dictionary:
	return _dict("ascension", "BOONS")


static func affixes() -> Array:
	return get_export("gameplay_affixRules", "AFFIXES")


## [min, max] for affix `id` at item level `ilvl` (1..99), baked from AFFIXES[i].range().
static func affix_range(id: String, ilvl: int) -> Array:
	var rows: Array = _dict("computed", "affixRanges").get(id, [])
	if rows.is_empty():
		return []
	return rows[clampi(ilvl, 1, rows.size()) - 1]


static func upgrade_cost(kind: String, tier: int) -> int:
	var costs: Array = _dict("computed", "upgradeCosts").get(kind, [])
	return int(costs[tier]) if tier >= 0 and tier < costs.size() else -1


# ---- gathering / crafting ----

static func gather_skills() -> Dictionary:
	return _dict("gameplay_gatheringRules", "SKILLS")


static func gather_nodes() -> Dictionary:
	return _dict("gameplay_gatheringRules", "NODES")


static func gather_node(id: String) -> Dictionary:
	return gather_nodes().get(id, {})


static func reagents() -> Dictionary:
	return _dict("reagents", "REAGENT_ITEMS")


## Every Workbench recipe as a Dictionary: { id, name, skill, level, result, qty, inputs: [ {item, qty} ] }
static func recipes() -> Array:
	if _recipes.is_empty():
		for row in get_export("recipes", "ALL_RECIPE_ROWS"):
			var inputs: Array = []
			for ing in row[6]:
				inputs.append({"item": ing[0], "qty": int(ing[1])})
			_recipes.append({"id": row[0], "name": row[1], "skill": row[2], "level": int(row[3]), "result": row[4], "qty": int(row[5]), "inputs": inputs})
	return _recipes


static func recipe(id: String) -> Dictionary:
	for r in recipes():
		if r["id"] == id:
			return r
	return {}


# ---- text / audio ----

static func codex(section: String) -> Variant:
	return get_export("codex", section)


## Covenant counsel tip: { title, body }
static func tip(id: String) -> Dictionary:
	return _dict("onboarding", "TIPS").get(id, {})


static func tips() -> Dictionary:
	return _dict("onboarding", "TIPS")


static func audio_map() -> Dictionary:
	return _dict("audioMap", "AUDIO_MAP")


# ---- loot (baked results of smartTable / depth helpers) ----

## smartTable(area, discipline): [ {item, weight} ]
static func smart_loot_table(area_id: String, discipline_id: String) -> Array:
	return _dict("computed", "smartTables").get(area_id, {}).get(discipline_id, [])


static func depth_roster(depth: int) -> Array:
	return _dict("computed", "depthRosters").get(str(depth), [])
