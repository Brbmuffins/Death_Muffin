class_name DmContent
extends RefCounted
## Typed access to the exported game content (godot/data/content/*.json, generated by tools/godot/export-content.ts).
## Everything is loaded lazily once (static cache). Dictionaries/Arrays returned are SHARED: do not mutate them (duplicate(true) first).
## NOTE: JSON numbers always arrive as float; wrap with int() where the TS value is an integer (hp, levels, counts, ms, sell).
##
## Generic:   DmContent.file("items")            -> the whole file as Dictionary { ExportName: value }
##            DmContent.get_export("areas", "DOORS")
##            DmContent.computed("smartTables")  -> value from computed.json (function results baked from the TS)
## Typed:     item(id) enemy(id) area(id) ability(id) discipline(id) boss(id) rune(id) brew(id) ... (see below)

const DIR := "res://data/content/"

static var _files: Dictionary = {}
static var _manifest: Dictionary = {}
static var _recipes: Array = []


## Drop the cache (tests / hot reload).
static func reset() -> void:
	_files = {}
	_manifest = {}
	_recipes = []


static func manifest() -> Dictionary:
	if _manifest.is_empty():
		_manifest = _read(DIR + "manifest.json")
	return _manifest


## Names of every exported file (without .json), excluding manifest.
static func file_names() -> PackedStringArray:
	var out := PackedStringArray()
	for k in manifest()["files"].keys():
		out.append(k)
	return out


static func file(name: String) -> Dictionary:
	if not _files.has(name):
		var path := DIR + name + ".json"
		if not FileAccess.file_exists(path):
			push_error("DmContent: unknown content file '%s'" % name)
			return {}
		_files[name] = _read(path)
	return _files[name]


static func get_export(file_name: String, export_name: String) -> Variant:
	return file(file_name).get(export_name)


static func computed(key: String) -> Variant:
	return file("computed").get(key)


static func _read(path: String) -> Dictionary:
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		push_error("DmContent: cannot open %s" % path)
		return {}
	var parsed: Variant = JSON.parse_string(f.get_as_text())
	if typeof(parsed) != TYPE_DICTIONARY:
		push_error("DmContent: %s is not a JSON object" % path)
		return {}
	return parsed


static func _dict(file_name: String, export_name: String) -> Dictionary:
	var v: Variant = get_export(file_name, export_name)
	return v if typeof(v) == TYPE_DICTIONARY else {}


# ---- items (content/items.ts: ITEMS) ----

## All item defs: id -> { name, type, rarity, sell, lore?, icon?, offlineStats?, stack? }
static func items() -> Dictionary:
	return _dict("items", "ITEMS")


static func has_item(id: String) -> bool:
	return items().has(id)


## Same fallback as TS itemMeta(): unknown ids become a 0-gold common material named after the id.
static func item(id: String) -> Dictionary:
	var d: Variant = items().get(id)
	if d != null:
		return d
	return {"name": id.replace("_", " "), "type": "material", "rarity": "common", "sell": 0}


static func rarity_color(rarity: String) -> String:
	return _dict("items", "RARITY_COLOR").get(rarity, "#ffffff")


static func rarity_mark(rarity: String) -> String:
	return _dict("items", "RARITY_MARK").get(rarity, "")


static func healing_flasks() -> Dictionary:
	return _dict("items", "HEALING_FLASKS")


static func buff_flasks() -> Dictionary:
	return _dict("items", "BUFF_FLASKS")


# ---- world content ----

static func enemies() -> Dictionary:
	return _dict("enemies", "ENEMIES")


static func enemy(id: String) -> Dictionary:
	return enemies().get(id, {})


static func areas() -> Dictionary:
	return _dict("areas", "AREAS")


static func area(id: String) -> Dictionary:
